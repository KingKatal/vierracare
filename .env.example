# ── Runtime ───────────────────────────────────────────────────
NODE_ENV=production
# Public canonical URL (no trailing slash). On Vercel this is auto-detected
# from VERCEL_PROJECT_PRODUCTION_URL if left empty, but set it for custom domains.
SITE_URL=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────
# Required for persistent data on Vercel. Use a pooled Postgres connection
# string (Neon, Vercel Postgres, Supabase, etc.).
# Leave empty locally to use the SQLite file in ./data.
DATABASE_URL=
# Set to "false" only for a Postgres server without TLS (local Docker, etc.).
# DATABASE_SSL=false

# ── Admin inbox login (/admin) ────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-long-password
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=paste-a-long-random-string

# ── Optional: email alerts when someone submits a form ────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vierra Care Services <hello@yourdomain.com>"
NOTIFY_TO=hello@yourdomain.com
